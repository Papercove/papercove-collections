<?xml version='1.0' encoding='utf-8'?>
<opml version="2.0">
  <head>
    <title>Marketing</title>
    <ownerName>Papercove</ownerName>
    <docs>https://opml.org/spec2.opml</docs>
  </head>
  <body>
    <outline text="Marketing" title="Marketing">
      <outline type="rss" text="Seth Godin" title="Seth Godin" xmlUrl="https://seths.blog/feed/" description="Short daily reflections on marketing, permission and doing work that matters." />
      <outline type="rss" text="SparkToro" title="SparkToro" xmlUrl="https://sparktoro.com/blog/feed/" description="Rand Fishkin and Amanda Natividad on audience research, zero-click marketing and smarter distribution, a few posts a month." />
      <outline type="rss" text="Ann Handley" title="Ann Handley" xmlUrl="https://annhandley.com/feed/" description="Warm, practical advice on writing and content marketing from the author of Everybody Writes, a couple of times a month." />
      <outline type="rss" text="Moz" title="Moz" xmlUrl="https://moz.com/feeds/blog.rss" description="Hands-on SEO tactics, case studies and industry analysis, one or two posts a week." />
      <outline type="rss" text="Growth Memo" title="Growth Memo" xmlUrl="https://www.growth-memo.com/feed" description="Kevin Indig's data-driven analysis of SEO, AI search and organic growth, about twice a week." />
      <outline type="rss" text="Google Search Central" title="Google Search Central" xmlUrl="https://developers.google.com/static/search/blog/feed.xml" description="Official updates on Google Search, ranking and structured data, straight from the source. A few posts a month." />
      <outline type="rss" text="Aleyda Solis" title="Aleyda Solis" xmlUrl="https://www.aleydasolis.com/en/feed/" description="International and technical SEO, AI search and practical frameworks from a leading consultant, about twice a month." />
      <outline type="rss" text="Ahrefs" title="Ahrefs" xmlUrl="https://ahrefs.com/blog/feed/" description="Research-backed SEO and AI search studies, with large datasets and step-by-step guides. Several posts a week." />
      <outline type="rss" text="Marketoonist" title="Marketoonist" xmlUrl="https://marketoonist.com/feed" description="Tom Fishburne's weekly cartoon poking fun at marketing clichés, with a short essay behind each one." />
      <outline type="rss" text="Buffer" title="Buffer" xmlUrl="https://buffer.com/resources/rss/" description="Social media marketing, transparent experiments and lessons from running a small, open company. Several posts a week." />
      <outline type="rss" text="Wes Kao" title="Wes Kao" xmlUrl="https://newsletter.weskao.com/feed" description="Sharp lessons on persuasive writing, positioning and communicating clearly at work, a couple of times a month." />
      <outline type="rss" text="Baymard Institute" title="Baymard Institute" xmlUrl="https://baymard.com/blog/feed.xml" description="Large-scale e-commerce UX research on checkout, product pages and conversion, a few posts a month." />
      <outline type="rss" text="MKT1" title="MKT1" xmlUrl="https://newsletter.mkt1.co/feed" description="Emily Kramer on building B2B startup marketing: teams, programs, positioning and launches. Every week or two." />
      <outline type="rss" text="Foundation" title="Foundation" xmlUrl="https://foundationinc.co/lab/feed/" description="B2B content strategy and distribution, with detailed breakdowns of what top brands do. A couple of posts a week." />
      <outline type="rss" text="Elena Verna" title="Elena Verna" xmlUrl="https://www.elenaverna.com/feed" description="Product-led growth, acquisition and retention from a seasoned growth leader, every week or two." />
      <outline type="rss" text="Grow and Convert" title="Grow and Convert" xmlUrl="https://www.growandconvert.com/feed/" description="Content marketing judged on conversions, not traffic, with real client data. About twice a month." />
      <outline type="rss" text="Mark Schaefer" title="Mark Schaefer" xmlUrl="https://businessesgrow.com/feed/" description="Marketing strategy, brand building and the human side of marketing, about once a week." />
      <outline type="rss" text="Jon Loomer" title="Jon Loomer" xmlUrl="https://www.jonloomer.com/feed/" description="Hands-on, no-fluff guidance on Meta advertising, from targeting and testing to new ad features, a couple of posts a week." />
      <outline type="rss" text="Occam's Razor" title="Occam's Razor" xmlUrl="https://www.kaushik.net/avinash/feed/" description="Avinash Kaushik's deep, opinionated essays on marketing analytics and measurement, every couple of months." />
      <outline type="rss" text="Backlinko" title="Backlinko" xmlUrl="https://backlinko.com/feed" description="In-depth, well-illustrated SEO guides and studies, refreshed for AI search. A couple of posts a month." />
    </outline>
  </body>
</opml>
